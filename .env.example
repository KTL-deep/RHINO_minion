RHINO_MINION_HOST=127.0.0.1
RHINO_MINION_PORT=8766
RHINO_MINION_LOG_LEVEL=INFO
RHINO_MINION_BRIDGE_SECRET=replace-with-a-long-random-secret
RHINO_MINION_PLANNER=deterministic
# To enable the OpenAI planner:
# RHINO_MINION_PLANNER=openai
# RHINO_MINION_OPENAI_API_KEY=
# RHINO_MINION_OPENAI_MODEL=

# Authentication (Keycloak/OIDC)
RHINO_MINION_AUTH_ENABLED=false
RHINO_MINION_OIDC_ISSUER=http://127.0.0.1:8080/realms/rhino-minion
RHINO_MINION_OIDC_CLIENT_ID=rhino-minion-desktop
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password

# YooKassa (configure a test shop first)
RHINO_MINION_YOOKASSA_SHOP_ID=
RHINO_MINION_YOOKASSA_SECRET_KEY=
RHINO_MINION_YOOKASSA_RETURN_URL=http://127.0.0.1:5173/?payment=return
RHINO_MINION_CREDITS_100_PRICE_RUB=0
