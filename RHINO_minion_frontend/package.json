{
  "name": "rhino-minion-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop control panel for RHINO Minion",
  "author": "RHINO Minion contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently --kill-others \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "desktop:pack": "npm run build && electron-builder --win nsis",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "oidc-client-ts": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "ai.rhinominion.desktop",
    "productName": "RHINO Minion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
